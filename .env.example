# ---- Sentinel: copy to .env and adjust ----

# Postgres / PostGIS
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:change_me_in_production@localhost:5432/sentinel

# Event bus: Valkey pub/sub over the Redis protocol (Kafka is the statewide design in the HLD)
REDIS_URL=redis://localhost:6379/0

# Media server (MediaMTX)
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WHEP_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
# Credential for pushing a stream into MediaMTX (the simulator publisher). URL-safe characters only:
# it goes inside an RTSP URL. Generate with: python -c "import secrets;print(secrets.token_urlsafe(24))"
MEDIAMTX_PUBLISH_PASS=dev_publish_key_replace_me

# Feed simulator catalogue (mirrors the sandbox catalogue API contract)
CATALOGUE_URL=http://localhost:8010

# API
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev_only_replace_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120
# For a live demo: 720, or the projected session signs out in the middle of the slot; sign in again just before it.
# CONFIDENCE_MARKING=false   # G3 (bench/pipeline_gates.md): mark reads below 0.9 and one-character alerts "check the crop"

# Analytics worker
DEVICE=cuda
DETECT_FPS=5
PLATE_MODEL=models/plate-yolov11n.pt
OCR_MODEL=cct-xs-v2-global-model
API_URL=http://localhost:8000
MIN_PLATE_CONF=0.35
MIN_OCR_CONF=0.35
# Not-a-plate rule: drop a read that fits a plate layout only after more than this many digits were turned into
# letters (a hoarding's phone number reads like that). A large value (e.g. 99) turns the rule off.
# MAX_LETTERS_FROM_DIGITS=1
# A worker on another machine than the relay (laptop B at the finale; see .env.b.example): the registry stores
# rtsp://localhost:8554/<code>, and RELAY_HOST is where "localhost" really is.
# RELAY_HOST=192.168.1.10
# The counts-only worker (python -m sentinel_analytics.counts): every analytics camera from keyframes, minus the
# plate workers' cameras, so no zone alerts twice. COUNTS_FPS=1.0, COUNTS_MAX_STREAMS=60, COUNTS_BATCH=16.
# COUNTS_EXCLUDE=CAM06,CAM07
# COUNTS_WORKER_ID=counts-1
CROP_DIR=data/crops
MAX_STREAMS=12

# Privacy posture: face recognition is deliberately disabled. See docs/privacy-dpdp.md
ENABLE_FACE_RECOGNITION=false

# API bootstrap + internal auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INGEST_KEY=dev_ingest_key_replace_me
HEALTH_INTERVAL_S=20
# 60 on someone else's network: each interval opens a TCP probe to every idle camera's server.
ALERT_COOLDOWN_S=120
FUZZY_MAX_EDITS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Control room opened from another machine on the LAN (operator laptop, finale): allow private addresses on port 5173.
# CORS_ORIGIN_REGEX=http://(10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+):5173
# The relay must advertise this machine's LAN address too, or a browser on another machine waits 15 s per tile and
# falls back to HLS: WEBRTC_HOST=127.0.0.1,<LAN address>. scripts/lan.ps1 writes both lines and restarts both.
# WEBRTC_HOST=127.0.0.1,192.168.1.10

# Analytics detector: yolo (real footage) | classical (synthetic sim) | both
DETECTOR=both
OCR_THREADS=2

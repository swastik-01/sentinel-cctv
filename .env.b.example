# Laptop B at the finale: workers only (the counts-only worker, and a plate worker if B has a GPU), pointed at
# laptop A, which runs the database, the API, the relay and the control room. Copy to .env on B and fill in A's
# LAN address. Every value here must match A's .env where it names a shared secret.

# --- where laptop A is ---------------------------------------------------------------------------------------
API_URL=http://192.168.1.10:8000          # A's address, port 8000 (scripts/lan.ps1 on A prints it)
RELAY_HOST=192.168.1.10                   # the registry stores rtsp://localhost:8554/<code>; B reaches A's relay here
INGEST_KEY=dev_ingest_key_replace_me      # the same value as A's .env, or B's batches are refused (401) and spool

# --- the counts-only worker (python -m sentinel_analytics.counts) ---------------------------------------------
COUNTS_WORKER_ID=counts-b
COUNTS_EXCLUDE=CAM06,CAM07                # the cameras A's plate worker takes: never counted twice (zones alert once)
COUNTS_MAX_STREAMS=60
COUNTS_FPS=1.0
OBJECT_MODEL=models/yolo11n.pt            # copy A's models/ folder: the stock COCO weights and the plate detector

# --- a plate worker on B, if it has an NVIDIA GPU (python -m sentinel_analytics.worker) -----------------------
# WORKER_ID=plates-b
# CAMERAS=CAM08,CAM09                     # its own cameras, also listed in A's COUNTS_EXCLUDE if A counts
# HW_DECODE=auto
# Crops a plate worker on B saves stay on B (data/crops): copy them to A before the detection report, or the
# report shows those sightings without a crop (docs/demo-runbook.md).

# --- the same analysis settings as A ------------------------------------------------------------------------
DEVICE=cuda
DETECTOR=both
STATIC_TEXT_WINDOW_S=600

# --- failover only: B takes over as the core (scripts/db_restore.ps1) -----------------------------------------
# Then B's own API, database and relay run, and they must use A's secrets so the restored users, the workers' key
# and the relay's publisher credential still match. Copy these from A's .env the day before (never from the repo):
# JWT_SECRET=
# ADMIN_PASSWORD=
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+asyncpg://sentinel:<POSTGRES_PASSWORD>@localhost:5432/sentinel
# MEDIAMTX_PUBLISH_PASS=
